---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { profile, skills, projects } from '../data/profile';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lê Văn Khiêm — DevOps Intern</title>
    <meta name="description" content="Lê Văn Khiêm — DevOps Intern in Hanoi. Explore hands-on projects with Linux, AWS, Terraform, Docker, Kubernetes, CI/CD, and GitOps." />
    <meta name="theme-color" content="#f4f3ed" />
    <link rel="canonical" href="https://khimkum.xyz/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Lê Văn Khiêm — DevOps Intern" />
    <meta property="og:description" content="Curious mind. Systems mindset. A portfolio of hands-on DevOps projects." />
    <meta property="og:url" content="https://khimkum.xyz/" />
    <meta property="og:image" content="https://khimkum.xyz/portrait.jpg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="#" aria-label="Khimkum home">khimkum<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Projects</a>
        <a href="#toolkit">Toolkit</a>
        <a href="#about">About</a>
      </nav>
      <a class="nav-contact" href={`mailto:${profile.email}`}>Let's talk <Arrow diagonal /></a>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-mark"></span> DEVOPS INTERN <span class="eyebrow-divider">/</span> HANOI, VIETNAM</p>
          <p class="intro-name">Hello, I'm {profile.name}.</p>
          <h1 id="hero-title">Curious mind.<br />Systems <em>mindset.</em></h1>
          <p class="hero-description">Learning to turn code into running systems — through cloud infrastructure, containers, and thoughtful automation.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#work">Explore my projects <Arrow /></a>
            <a class="text-link" href={profile.resume} download>Download CV <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-footnote"><span class="availability-dot"></span> Seeking a DevOps internship <span class="muted-separator">·</span> KMA student</div>
        </div>
        <div class="hero-visual">
          <div class="portrait-card">
            <div class="portrait-topline"><span>GET TO KNOW ME</span><span>01 / PROFILE</span></div>
            <div class="portrait-wrap"><img src="/portrait.jpg" alt="Portrait of Lê Văn Khiêm" width="600" height="600" fetchpriority="high" /></div>
            <div class="portrait-caption"><div><strong>{profile.name}</strong><span>DevOps Intern</span></div><a class="round-link" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="Visit Lê Văn Khiêm on GitHub"><Arrow diagonal /></a></div>
          </div>
          <div class="learning-note"><span class="note-symbol" aria-hidden="true">↳</span><span>Build. Understand.<br /><strong>Improve. Repeat.</strong></span></div>
        </div>
      </section>

      <div class="stack-band" aria-label="Core technologies">
        <div class="shell stack-band-inner"><span class="stack-band-label">WORKING WITH</span><span>Linux</span><i aria-hidden="true">✳</i><span>Docker</span><i aria-hidden="true">✳</i><span>Kubernetes</span><i aria-hidden="true">✳</i><span>AWS</span><i aria-hidden="true">✳</i><span>Terraform</span></div>
      </div>

      <section id="work" class="work-section shell section-space" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">01 — SELECTED WORK</p><h2 id="work-title">Learning, put into practice.</h2></div><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">All repositories <Arrow diagonal /></a></div>
        <div class="projects">
          {projects.map((project, index) => (
            <article class:list={['project', { 'project-alternate': index === 1 }]}>
              <div class="project-illustration" aria-hidden="true">
                <div class="illustration-top"><span>PROJECT / {project.id}</span><span>{index === 0 ? 'CLOUD DELIVERY' : 'CONTAINER LAB'}</span></div>
                <div class="infra-symbol">{index === 0 ? <svg width="112" height="92" viewBox="0 0 112 92" fill="none"><path d="M30 65H23a17 17 0 0 1-1-34 29 29 0 0 1 56-4 20 20 0 1 1 9 38h-6" stroke="currentColor" stroke-width="2"/><rect x="34" y="47" width="44" height="30" rx="3" stroke="currentColor" stroke-width="2"/><path d="M43 57h26M43 66h13M56 77v10M44 87h24" stroke="currentColor" stroke-width="2"/></svg> : <svg width="112" height="100" viewBox="0 0 112 100" fill="none"><path d="m56 7 38 22v44L56 95 18 73V29L56 7Z" stroke="currentColor" stroke-width="2"/><path d="m18 29 38 22 38-22M56 51v44M37 18l38 22v22L56 73 37 62V40l38-22" stroke="currentColor" stroke-width="1.5"/></svg>}</div>
                <div class="project-flow">{project.flow.map((step, stepIndex) => <><span>{step}</span>{stepIndex < project.flow.length - 1 && <b>→</b>}</>)}</div>
                <div class="illustration-bottom"><span>{index === 0 ? 'INFRASTRUCTURE AS CODE' : 'PERSISTENCE & RECOVERY'}</span><span>↗</span></div>
              </div>
              <div class="project-copy"><p class="project-category">{project.category}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p><ul class="project-details">{project.details.map(detail => <li>{detail}</li>)}</ul><ul class="tags" aria-label="Project technologies">{project.technologies.map(tool => <li>{tool}</li>)}</ul><a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">Explore repository <Arrow diagonal /></a></div>
            </article>
          ))}
        </div>
      </section>

      <section id="toolkit" class="toolkit-section section-space" aria-labelledby="toolkit-title"><div class="shell toolkit-layout"><div class="toolkit-intro"><p class="eyebrow">02 — MY TOOLKIT</p><h2 id="toolkit-title">The tools behind<br />the practice.</h2><p>Hands-on familiarity built through coursework and personal projects. Always a little more to learn.</p><span class="toolkit-decoration" aria-hidden="true">{`{ }`}</span></div><div class="skill-list">{skills.map((skill, index) => <div class="skill-row"><span class="skill-index">0{index + 1}</span><div><h3>{skill.name}</h3><p>{skill.tools.join(' · ')}</p></div><span class="skill-arrow" aria-hidden="true">↗</span></div>)}</div></div></section>

      <section id="about" class="about-section shell section-space" aria-labelledby="about-title"><div class="about-copy"><p class="eyebrow">03 — A LITTLE ABOUT ME</p><h2 id="about-title">A student of technology.<br /><em>And of how things work.</em></h2><p>{profile.objective}</p><p>I value collaboration, clear communication, and steady self-learning. Outside of technology, I enjoy sports, traveling, and reading technology blogs.</p><a class="text-link" href={profile.resume} download>Get the full CV <span aria-hidden="true">↓</span></a></div><aside class="education-card" aria-label="Education"><span class="education-icon" aria-hidden="true">↗</span><p class="eyebrow">EDUCATION</p><span class="education-years">{profile.education.years}</span><h3>{profile.education.degree}</h3><p>{profile.education.school}</p><p class="school-original" lang="vi">{profile.education.originalName}</p><div class="education-location">Hanoi, Vietnam</div></aside></section>

      <section id="contact" class="contact-section"><div class="shell"><div class="contact-topline"><p class="eyebrow">04 — LET'S CONNECT</p><span>OPEN TO INTERNSHIP OPPORTUNITIES</span></div><h2>Let's build<br />something <em>meaningful.</em></h2><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Arrow diagonal /></a><div class="contact-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal /></a><a href={profile.resume} download>Download CV <span aria-hidden="true">↓</span></a><a href="tel:+84338882562">{profile.phone}</a></div></div></section>
    </main>
    <footer class="site-footer shell"><a class="brand" href="#">khimkum<span>.</span></a><p>© {new Date().getUTCFullYear()} {profile.name}</p><a href="#main">Back to top ↑</a></footer>
  </body>
</html>
