# Replace the tunnel ID and credential path after Cloudflare authorization.
# Never put the credential JSON or cert.pem in Git.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /home/khimkum/.cloudflared/REPLACE_WITH_TUNNEL_UUID.json
ingress:
  - hostname: khimkum.xyz
    service: http://127.0.0.1:8080
    originRequest:
      connectTimeout: 10s
  - service: http_status:404
